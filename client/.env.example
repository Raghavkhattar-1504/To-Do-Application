# Base URL of the API, with no trailing slash and no /api suffix
# (the client appends /api/... itself). Leave empty in development to use
# the Vite dev server proxy below instead of a real network request.
#
# Production example, after the API is deployed (Render, Railway, ...):
# VITE_API_URL=https://todo-api.onrender.com
VITE_API_URL=

# Dev-server only: where Vite's /api proxy forwards requests when
# VITE_API_URL is empty. Defaults to http://localhost:5000. Set this if
# your local API runs on a different port, for example because 5000 is
# already in use on your machine.
# API_PROXY_TARGET=http://localhost:5050
