# MongoDB connection string. For local development this points at the
# Docker container started by `npm run db:up`. For a deployed API, use a
# MongoDB Atlas connection string instead (Render and Railway do not offer
# a first-party managed MongoDB).
MONGODB_URI=mongodb://localhost:27017/todo

# Port the API listens on. Render and Railway set this automatically in
# production; the app falls back to 5000 when it is unset.
PORT=5000

# Allowed origin(s) for the client, comma-separated for more than one
# (for example a Netlify production URL plus a deploy preview URL).
# Must match the client's real origin exactly, including https://.
CLIENT_ORIGIN=http://localhost:5173

# Optional: used only by server/test/tasks.test.js. Set this to run the
# test suite against the Docker MongoDB instead of an in-memory server
# (which otherwise downloads a ~600 MB MongoDB binary on first run).
# MONGODB_TEST_URI=mongodb://localhost:27017/todo_test
